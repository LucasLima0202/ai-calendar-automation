# ─── Trigger.dev ───────────────────────────────────────────────
# Project ref: cloud.trigger.dev → seu projeto → Project settings (começa com proj_)
TRIGGER_PROJECT_REF=
# Chave do ambiente DEV: cloud.trigger.dev → API Keys → Development (começa com tr_dev_)
TRIGGER_SECRET_KEY=

# ─── ClickUp ───────────────────────────────────────────────────
# Token pessoal: ClickUp → avatar → Settings → Apps → API Token (começa com pk_)
CLICKUP_API_TOKEN=
# Team ID = número na URL do ClickUp (app.clickup.com/<TEAM_ID>/...).
# Os 3 abaixo são preenchidos depois de rodar a task "agenda-setup-clickup" (ela devolve os IDs)
CLICKUP_TEAM_ID=
CLICKUP_SPACE_ID=
CLICKUP_LIST_BRIEFINGS_ID=
CLICKUP_LIST_IDEIAS_ID=

# ─── Google Gemini (IA dos insights) ───────────────────────────
# aistudio.google.com → Get API key
GEMINI_API_KEY=
# Opcional: força um modelo específico (padrão: gemini-3.5-flash; reservas: gemini-3.8-flash, gemini-3.5-flash-lite)
# GEMINI_MODEL=

# ─── Resend (email) ────────────────────────────────────────────
# resend.com → API Keys (começa com re_)
RESEND_API_KEY=
# Email que recebe os briefings. Sem domínio verificado no Resend, precisa ser o MESMO email da sua conta Resend.
BRIEFING_EMAIL_TO=

# ─── Google Agenda (API) ───────────────────────────────────────
# Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth (tipo "Aplicativo da Web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gerado no OAuth Playground (developers.google.com/oauthplayground) com escopo .../auth/calendar
GOOGLE_REFRESH_TOKEN=
# Preenchidos depois de rodar a task "gcal-setup-calendars" (ela devolve os IDs)
GCAL_CAL_TRABALHO_ID=
GCAL_CAL_ESTUDOS_ID=
GCAL_CAL_PESSOAL_ID=
GCAL_CAL_TAREFAS_ID=
